opam-version: "2.0"

synopsis: "A mini-github application"
description: "This application is a sample project on how to combine irmin-graphql with dream and display queries on he browser using js_of_ocaml"

license: "MIT"
homepage: "https://github.com/dinakajoy/simple_mini_github"
bug-reports: "https://github.com/dinakajoy/simple_mini_github/issues"

author: "Odinaka Joy <dinakajoy@gmail.com> and Patrick Ferris <pf341@patricoferris.com>"
maintainer: "Odinaka Joy <dinakajoy@gmail.com> and Patrick Ferris <pf341@patricoferris.com>"

depends: [
  "ocaml" {>= "4.14.1"}
  "dune" {>= "2.9.0"}
  "dream"
  "js_of_ocaml"
  "js_of_ocaml-lwt"
  "js_of_ocaml-ppx"
  "yojson"
  "brr"
  "omd"
  "cohttp-lwt-unix"
  "lwt"
  "irmin" 
  "irmin-graphql" 
  "irmin-git"
]